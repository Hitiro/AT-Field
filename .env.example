# Variáveis de ambiente da API do AT-Field
# Copie para apps/api/.env e ajuste. O arquivo .env é ignorado pelo Git.

# Aplicação
NODE_ENV=development
PORT=4310

# PostgreSQL (usado pela API e pelo docker-compose.yml)
# Subir o banco: docker compose --env-file apps/api/.env up -d
DATABASE_HOST=localhost
DATABASE_PORT=54310
DATABASE_USER=postgres
DATABASE_PASSWORD=defina_uma_senha_local
DATABASE_NAME=at_field
