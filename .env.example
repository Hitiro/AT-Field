# Variáveis de ambiente da API do AT-Field
# Copie para apps/api/.env e ajuste. O arquivo .env é ignorado pelo Git.

# Aplicação
NODE_ENV=development
PORT=4310

# Log (passo 008): nível mínimo e formato
# LOG_LEVEL=fatal|error|warn|log|debug|verbose
LOG_LEVEL=log
# LOG_FORMAT=pretty|json (padrão: json em production, pretty fora)

# Firebase Auth (passo 009a). A API só verifica o ID token (Bearer).
# Id do projeto no console do Firebase (Configurações do projeto). Não é
# segredo, mas o valor real fica só no apps/api/.env.
FIREBASE_PROJECT_ID=seu-projeto-firebase
# Checa revogação de sessão no Firebase a cada requisição (custo e latência).
# Exige GOOGLE_APPLICATION_CREDENTIALS.
# AUTH_CHECK_REVOKED=false
# Caminho do JSON da service account (fora do repositório, ex.: .local/credenciais/).
# Só é necessário com AUTH_CHECK_REVOKED=true.
# GOOGLE_APPLICATION_CREDENTIALS=
# Auth Emulator, só em dev/teste: com ela o SDK aceita token SEM assinatura.
# Só host loopback (localhost, 127.0.0.1, [::1]) e proibida com
# NODE_ENV=production (a API não sobe).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# PostgreSQL (usado pela API e pelo docker-compose.yml)
# Subir o banco: docker compose --env-file apps/api/.env up -d
DATABASE_HOST=localhost
DATABASE_PORT=54310
DATABASE_USER=postgres
DATABASE_PASSWORD=defina_uma_senha_local
DATABASE_NAME=at_field
