# Fim de linha LF em todo o repositório, inclusive no Windows (o Prettier e o
# ESLint exigem LF; com core.autocrlf=true o checkout viraria CRLF).
* text=auto eol=lf

.husky/* text eol=lf
*.sh text eol=lf

# Binários: sem conversão nem diff de texto
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
